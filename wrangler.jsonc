{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-gate-tans",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/solid-start/server-entry",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "wa-gate.buseldata.com/*",
      "zone_name": "buseldata.com"
    }
  ]
}
